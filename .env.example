PORT=6798

# Authentication configuration
JWT_SECRET=your-jwt-secret-key

# Checkbox board behavior
CHECKBOX_COUNT=500
RATE_LIMIT_WINDOW_MS=3000

# Redis connection
# Use REDIS_URL for hosted Redis/Valkey, or REDIS_HOST + REDIS_PORT for local Docker.
# REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
